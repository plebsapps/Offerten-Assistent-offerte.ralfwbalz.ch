# Gesprächs-KI: 'claude' (Anthropic, Default) oder 'openai' (ChatGPT, Modell gpt-4.1).
# Im Admin (/admin/einstellungen) zur Laufzeit umschaltbar; dieser Wert ist nur der Default.
KI_ANBIETER=claude

# Anthropic / Claude (LLM des Agenten)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI: Sprach-Ein-/Ausgabe (Whisper-STT + neuronales TTS) UND – falls KI_ANBIETER=openai –
# das Beratungsgespräch selbst. Daher in beiden Fällen erforderlich.
OPENAI_API_KEY=sk-...
# Optional: Stimme und Tempo der Sprachausgabe (Default: nova, 1.2)
# OPENAI_TTS_VOICE=nova
# OPENAI_TTS_SPEED=1.2

# SMTP-Versand (Offerte an Ralf, Freigabe an Auftraggeber)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine-adresse@gmail.com
SMTP_PASSWORD=dein-app-passwort
CONTACT_EMAIL=balz.ralf@gmail.com

# Öffentliche Basis-URL (Freigabe-Link in der Mail an Ralf UND Einladungslinks/-Mails).
# Ist sie leer, fällt der Code auf https://offerte.ralfwbalz.ch zurück (nie localhost nach aussen).
PUBLIC_BASE_URL=https://offerte.ralfwbalz.ch
# Lokal stattdessen z. B.: PUBLIC_BASE_URL=http://localhost:8003

# Homepage-Ziel für den Sprung nach erstellter Offerte
HOMEPAGE_URL=https://ralfwbalz.ch

# Speicherort für SQLite-DB und erzeugte PDFs (Docker-Volume)
DATA_DIR=/data

# Admin-Bereich (/admin). Passwort als bcrypt-Hash hinterlegen, z. B.:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'MEIN-PASSWORT', bcrypt.gensalt()).decode())"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Signiert das Session-Cookie (Admin-Login + Einladungs-Zugang). Lang & zufällig wählen, z. B.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=unsicher-bitte-setzen

# Missbrauchs-/Kostenschutz
# Hard-Limits (Gespräch endet) und Soft-Limits (Agent leitet sanft zum Abschluss über).
# Greift, was zuerst erreicht wird – Turns ODER Token. Im Admin überschreibbar.
MAX_SESSIONS_PER_IP=5
MAX_TURNS_PER_SESSION=40
SOFT_TURNS=30
MAX_TOKENS_PER_SESSION=150000
SOFT_TOKENS=110000
